# Optional. Without an API key the service runs in retrieval-only mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
EVIDENCETRACE_DB_PATH=data/evidencetrace.db
EVIDENCETRACE_TOP_K=6
EVIDENCETRACE_MIN_RETRIEVAL_SCORE=0.05
EVIDENCETRACE_MIN_TERM_COVERAGE=0.50
# Requires: pip install ".[semantic]". Enable only after benchmarking.
EVIDENCETRACE_SEMANTIC_ENABLED=false
EVIDENCETRACE_SEMANTIC_MODEL=all-MiniLM-L6-v2
EVIDENCETRACE_SEMANTIC_RRF_WEIGHT=0.70
