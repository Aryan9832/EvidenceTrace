# Optional. Without an API key the service runs in retrieval-only mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
EVIDENCETRACE_DB_PATH=data/evidencetrace-v0.2.db
EVIDENCETRACE_TOP_K=6
EVIDENCETRACE_MIN_RETRIEVAL_SCORE=0.05
EVIDENCETRACE_MIN_TERM_COVERAGE=0.50
# Requires: pip install ".[semantic]". Enable only after benchmarking.
EVIDENCETRACE_SEMANTIC_ENABLED=false
EVIDENCETRACE_SEMANTIC_MODEL=all-MiniLM-L6-v2
EVIDENCETRACE_SEMANTIC_RRF_WEIGHT=0.70

# Optional Gemini generation; choose a model available to your own API account.
# Both values are required. Generation is operator-only and can incur provider fees.
GEMINI_API_KEY=
GEMINI_MODEL=
# Operator key for private review/report/ingestion endpoints on a hosted service.
# Set a strong random value outside source control. Never embed it in the UI.
EVIDENCETRACE_OPERATOR_KEY=
# Only the preview launcher enables loopback access. Keep false on hosted deployments.
EVIDENCETRACE_LOCAL_MODE=false
